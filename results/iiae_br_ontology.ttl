@prefix iiae: <http://iiae-br.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iiae:ContractNet a iiae:InteractionProtocol ;
    rdfs:label "FIPA ContractNet Protocol" .

iiae:IteratedContractNet a iiae:InteractionProtocol ;
    rdfs:label "FIPA IteratedContractNet Protocol" .

iiae:Propose a iiae:InteractionProtocol ;
    rdfs:label "FIPA Propose Protocol" .

iiae:QueryRef a iiae:InteractionProtocol ;
    rdfs:label "FIPA QueryRef Protocol" .

iiae:Request a iiae:InteractionProtocol ;
    rdfs:label "FIPA Request Protocol" .

iiae:Subscribe a iiae:InteractionProtocol ;
    rdfs:label "FIPA Subscribe Protocol" .

iiae:agentId a owl:DatatypeProperty ;
    rdfs:label "agentId" ;
    rdfs:domain iiae:Agent ;
    rdfs:range xsd:string .

iiae:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    rdfs:domain iiae:Product ;
    rdfs:range xsd:string .

iiae:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:domain iiae:Order ;
    rdfs:range iiae:Product .

iiae:delivers a owl:ObjectProperty ;
    rdfs:label "delivers" ;
    rdfs:domain iiae:LogisticsAgent ;
    rdfs:range iiae:Delivery .

iiae:fulfills a owl:ObjectProperty ;
    rdfs:label "fulfills" ;
    rdfs:domain iiae:SellerAgent ;
    rdfs:range iiae:Order .

iiae:hasPay a owl:ObjectProperty ;
    rdfs:label "hasPayment" ;
    rdfs:domain iiae:Order ;
    rdfs:range iiae:Payment .

iiae:latencyMs a owl:DatatypeProperty ;
    rdfs:label "latencyMs" ;
    rdfs:domain iiae:Transaction ;
    rdfs:range xsd:float .

iiae:mediates a owl:ObjectProperty ;
    rdfs:label "mediates" ;
    rdfs:domain iiae:MediatorAgent ;
    rdfs:range iiae:Transaction .

iiae:orderId a owl:DatatypeProperty ;
    rdfs:label "orderId" ;
    rdfs:domain iiae:Order ;
    rdfs:range xsd:string .

iiae:places a owl:ObjectProperty ;
    rdfs:label "places" ;
    rdfs:domain iiae:BuyerAgent ;
    rdfs:range iiae:Order .

iiae:price a owl:DatatypeProperty ;
    rdfs:label "price" ;
    rdfs:domain iiae:Product ;
    rdfs:range xsd:float .

iiae:receives a owl:ObjectProperty ;
    rdfs:label "receives" ;
    rdfs:domain iiae:Agent ;
    rdfs:range iiae:FIPAMessage .

iiae:sends a owl:ObjectProperty ;
    rdfs:label "sends" ;
    rdfs:domain iiae:Agent ;
    rdfs:range iiae:FIPAMessage .

iiae:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:domain iiae:Order ;
    rdfs:range xsd:string .

iiae:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:domain iiae:FIPAMessage ;
    rdfs:range xsd:dateTime .

iiae:usesProtocol a owl:ObjectProperty ;
    rdfs:label "usesProtocol" ;
    rdfs:domain iiae:FIPAMessage ;
    rdfs:range iiae:InteractionProtocol .

iiae:BuyerAgent a owl:Class ;
    rdfs:label "BuyerAgent" ;
    rdfs:comment "Agent representing a consumer" ;
    rdfs:subClassOf iiae:Agent .

iiae:Delivery a owl:Class ;
    rdfs:label "Delivery" ;
    rdfs:comment "A delivery/shipment" .

iiae:LogisticsAgent a owl:Class ;
    rdfs:label "LogisticsAgent" ;
    rdfs:comment "Logistics and delivery agent" ;
    rdfs:subClassOf iiae:Agent .

iiae:MediatorAgent a owl:Class ;
    rdfs:label "MediatorAgent" ;
    rdfs:comment "Marketplace mediator agent" ;
    rdfs:subClassOf iiae:Agent .

iiae:Payment a owl:Class ;
    rdfs:label "Payment" ;
    rdfs:comment "A payment associated with an order" .

iiae:SellerAgent a owl:Class ;
    rdfs:label "SellerAgent" ;
    rdfs:comment "Agent representing a seller" ;
    rdfs:subClassOf iiae:Agent .

iiae:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A product offered for sale" .

iiae:Transaction a owl:Class ;
    rdfs:label "Transaction" ;
    rdfs:comment "An e-commerce transaction" .

iiae:FIPAMessage a owl:Class ;
    rdfs:label "FIPAMessage" ;
    rdfs:comment "A FIPA-ACL message" .

iiae:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A purchase order" ;
    rdfs:subClassOf iiae:Transaction .

iiae:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An autonomous software agent" .

iiae:InteractionProtocol a owl:Class ;
    rdfs:label "InteractionProtocol" ;
    rdfs:comment "A FIPA interaction protocol" .

